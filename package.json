{
    "name": "tiktok-downloader",
    "version": "1.0.0",
    "description": "أداة تحميل فيديوهات تيك توك بدون علامة مائية",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "nodemon server.js",
        "sync": "node scripts/sync-public.js",
        "cookies:refresh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/refresh-cookies.ps1",
        "cookies:refresh:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/refresh-cookies.ps1 -WatchMinutes 360",
        "predeploy:firebase": "node scripts/sync-public.js",
        "deploy:firebase": "firebase deploy --only hosting"
    },
    "keywords": [
        "tiktok",
        "downloader",
        "video"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "express": "^4.18.2",
        "cors": "^2.8.5"
    },
    "devDependencies": {
        "nodemon": "^3.0.1"
    }
}
